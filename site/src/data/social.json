  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzuo44zpyc2h",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Three years of the Zero Debris Charter!\n\nMore than 250 signatories from 36 countries are now working towards a zero debris future by 2030, with confidence growing that the technical targets can be achieved, and new members joining last week in Brasília. \n\nRead more: esa.int/articles/abo...",
    "url": "https://bsky.app/profile/esa.int/post/3mzuo44zpyc2h",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreihktyw6qbtb2f7po64re6swgxe6vnqjnellexwbzeiyczqzqsk6di",
    "publishedAt": "2026-11-09T09:59:26.670Z",
    "likes": 139,
    "reposts": 15,
    "starship": false
  },
  {
    "id": "at://did:plc:cbjn5rfoo4owohtvovqdqoss/app.bsky.feed.post/3mzomy5mwyc2t",
    "platform": "bluesky",
    "author": "Spaceflight Now",
    "handle": "spaceflightnow.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:cbjn5rfoo4owohtvovqdqoss/bafkreib5gq4ycdgpitpk3rlno3j3mnqid6qgubnq7z4ghs4sg3ece5ptxi",
    "text": "SpaceX will deploy another batch of satellites for a clandestine U.S. Space Force program on a Falcon 9 rocket launch from California. Liftoff is scheduled for 4:48 p.m. PST (7:48 p.m. EST / 0048 UTC). Watch live coverage: youtube.com/live/5zPZKJi...",
    "url": "https://bsky.app/profile/spaceflightnow.com/post/3mzomy5mwyc2t",
    "image": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:cbjn5rfoo4owohtvovqdqoss/bafkreifeiwokwichjslt5g4sz7lhxamz4ekdprtjmdowvfc66geqd6wsuu",
    "publishedAt": "2026-11-07T00:23:19.581Z",
    "likes": 5,
    "reposts": 1,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzlbclgvak2w",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Closing in on Didymos. ☄️\n\nOur planetary defence mission Hera has captured its first close-up of the binary asteroid system, 60 km away, as it prepares to investigate the aftermath of DART’s historic impact with Dimorphos.\n\nDetailed images of both asteroids are coming on 25 November.",
    "url": "https://bsky.app/profile/esa.int/post/3mzlbclgvak2w",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreie74pu62mcpdauj6bvjmel2wkiotxw2j7lxwd3iehfc35bgdfou4q",
    "publishedAt": "2026-11-05T16:16:26.882Z",
    "likes": 357,
    "reposts": 68,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzkig4us3c2i",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Mars may not be geologically dead after all. 🔴 \n\nOur ExoMars Trace Gas Orbiter has detected hydrogen chloride above volcanic fissures in the Alba Mons region, which scientists suggest could be linked to dormant volcanic activity beneath the surface. \n\nRead more: new.esa.int/articles/new...",
    "url": "https://bsky.app/profile/esa.int/post/3mzkig4us3c2i",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibdzzekyojnq2nnsdacgfv5gup55vrkflhppemytukaxelnn2x3c4",
    "publishedAt": "2026-11-05T08:51:10.971Z",
    "likes": 282,
    "reposts": 66,
    "starship": false
  },
  {
    "id": "at://did:plc:cbjn5rfoo4owohtvovqdqoss/app.bsky.feed.post/3mzj7iiamlc2i",
    "platform": "bluesky",
