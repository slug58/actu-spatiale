    "likes": 83,
    "reposts": 27,
    "starship": false
  },
  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3mzxkxg4ry227",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreic7pwkmzswncacrgd7sp2zpyfdzijbvn5ai4sznhcj6b6wi7vjx54",
    "text": "Starship Booster 22 is back on the Launch Pad 2 Orbital Launch Mount, after rolling to the pad overnight. Hopefully its Flight 15 partner, Ship 42, will join it at the pad soon, ahead of launch currently scheduled for this Friday, November 13th, pending regulatory approval. \nnsf.live/starbase",
    "url": "https://bsky.app/profile/nasaspaceflight.com/post/3mzxkxg4ry227",
    "image": "https://video.bsky.app/watch/did%3Aplc%3Ayifpqamzwvp3g4szr44mz37r/bafkreifaoh3wqwnzatd5i5tm5hbq5uzfm67767pj3ar3aemstv73kqrorq/thumbnail.jpg",
    "publishedAt": "2026-11-10T13:41:07.476Z",
    "likes": 23,
    "reposts": 2,
    "starship": true
  },
  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3mzxfiswork2j",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreic7pwkmzswncacrgd7sp2zpyfdzijbvn5ai4sznhcj6b6wi7vjx54",
    "text": "Upcoming launches this week include the return of Vulcan and Starship's double-catch attempt.\n\nBy Joe Kangas\n\nwww.nasaspaceflight.com/2026/11/laun...",
    "url": "https://bsky.app/profile/nasaspaceflight.com/post/3mzxfiswork2j",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreifdmd4wlhs3nwgyuohs2w2sby2g2wnyddascaxzgafhjhfmme4lnm",
