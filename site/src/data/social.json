  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzxtp77hyc2g",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "The developing El Niño could weaken Earth’s natural carbon sinks. 🌎\n\nUsing satellite observations, climate forecasts and modelling, ESA-supported research is helping anticipate where carbon losses and wildfire risks could be greatest before the impacts peak.\n\n🔗 www.esa.int/articles/abo...",
    "url": "https://bsky.app/profile/esa.int/post/3mzxtp77hyc2g",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreie4ydnfnxethulm6hsprgczi2kpypivo2df5d65i2qwz7u4ehwa4m",
