  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3n35qlu7ruk2e",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreiaj4ng5nwiv6hkptuzo4ijlgifxc7tptrwag6advsmjx2fohkwtfu",
    "text": "BIG NEWS! We have a whole new look at Dimorphos, the first asteroid humans have ever moved 👀\n\nOur Hera mission has captured Dimorphos completing a full orbit around its larger companion, Didymos. Look closely and you will see the impact site come into view.",
    "url": "https://bsky.app/profile/esa.int/post/3n35qlu7ruk2e",
    "image": "https://video.bsky.app/watch/did%3Aplc%3Ayqfmy2p54vqgekrcz5zzykhl/bafkreigwv6l7pnd2rptkrdzknphweg7aqki3bio6ec6txfmxtut42rkynq/thumbnail.jpg",
    "publishedAt": "2026-11-25T18:03:12.944Z",
    "likes": 750,
    "reposts": 290,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3n34yzjruzs27",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreiaj4ng5nwiv6hkptuzo4ijlgifxc7tptrwag6advsmjx2fohkwtfu",
    "text": "Four years ago, humans moved an asteroid for the first time. Tonight, you get to see what we did to it.\n\nOur @esa spacecraft's first close-up images of Dimorphos go live from 19:45 CET, on ESA WebTV and our YouTube channel.",
    "url": "https://bsky.app/profile/esa.int/post/3n34yzjruzs27",
    "image": null,
    "publishedAt": "2026-11-25T11:01:20.151Z",
    "likes": 219,
    "reposts": 50,
    "starship": false
  },
  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3n34o7tpdp223",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
