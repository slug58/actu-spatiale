    "starship": false
  },
  {
    "id": "at://did:plc:uwe7uhjncj4ducqvn5xmma7b/app.bsky.feed.post/3mzv5ldkrls2k",
    "platform": "bluesky",
    "author": "scottmanley.bsky.social",
    "handle": "scottmanley.bsky.social",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreid742zu52jbw3vp4bvo5rzwc2caavpas4pgzrz4k5j5olsxj7ijfe",
    "text": "Had a lot of fun at NASA's big Airshow event, I talked with people at every level in NASA - engineers, scientists, pilots, astronauts and even the administrator. There was a lot more than just planes flying around, I barely had time to take it all in.",
    "url": "https://bsky.app/profile/scottmanley.bsky.social/post/3mzv5ldkrls2k",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreic3jp7wafbltlvq5moaecvqycclazs5c2erifcrxvzbsh5vmkn6vy",
