  {
    "id": "at://did:plc:uwe7uhjncj4ducqvn5xmma7b/app.bsky.feed.post/3n24tolvets2x",
    "platform": "bluesky",
    "author": "scottmanley.bsky.social",
    "handle": "scottmanley.bsky.social",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreid742zu52jbw3vp4bvo5rzwc2caavpas4pgzrz4k5j5olsxj7ijfe",
    "text": "The Artemis II image of the Earth illuminated by moonlight was one of my favourite pictures of the year, and in the same minute the DSCOVR spacecraft captured an image of the sunlit side of the Earth",
    "url": "https://bsky.app/profile/scottmanley.bsky.social/post/3n24tolvets2x",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreifa7pbwimhkew7cp4ddigslalk4qafp3tlxkyyenzke64uzhxg5he",
    "publishedAt": "2026-11-12T16:00:36.988Z",
    "likes": 44,
    "reposts": 3,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3n24qjiz3ec2r",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Our Euclid space telescope has released its largest dataset yet, revealing over 900 million galaxies!\n\nCovering an area of sky equivalent to 9500 full Moons, the data lays the foundation for an unprecedented 3D map of the Universe.",
    "url": "https://bsky.app/profile/esa.int/post/3n24qjiz3ec2r",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibn5cd2mpwkthy4mjuep3f24hfzelfvkuhvui4zvbgow33goumxse",
    "publishedAt": "2026-11-12T15:04:07.485Z",
    "likes": 203,
    "reposts": 43,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3n22fpjcvzc2f",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Getting closer..",
    "url": "https://bsky.app/profile/esa.int/post/3n22fpjcvzc2f",
    "image": null,
    "publishedAt": "2026-11-11T16:45:08.887Z",
    "likes": 116,
    "reposts": 10,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzxtp77hyc2g",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "The developing El Niño could weaken Earth’s natural carbon sinks. 🌎\n\nUsing satellite observations, climate forecasts and modelling, ESA-supported research is helping anticipate where carbon losses and wildfire risks could be greatest before the impacts peak.\n\n🔗 www.esa.int/articles/abo...",
    "url": "https://bsky.app/profile/esa.int/post/3mzxtp77hyc2g",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreie4ydnfnxethulm6hsprgczi2kpypivo2df5d65i2qwz7u4ehwa4m",
    "publishedAt": "2026-11-10T16:17:37.171Z",
    "likes": 86,
    "reposts": 28,
    "starship": false
  },
  {
    "id": "at://did:plc:uwe7uhjncj4ducqvn5xmma7b/app.bsky.feed.post/3mzv5ldkrls2k",
    "platform": "bluesky",
    "author": "scottmanley.bsky.social",
    "handle": "scottmanley.bsky.social",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreid742zu52jbw3vp4bvo5rzwc2caavpas4pgzrz4k5j5olsxj7ijfe",
    "text": "Had a lot of fun at NASA's big Airshow event, I talked with people at every level in NASA - engineers, scientists, pilots, astronauts and even the administrator. There was a lot more than just planes flying around, I barely had time to take it all in.",
    "url": "https://bsky.app/profile/scottmanley.bsky.social/post/3mzv5ldkrls2k",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreic3jp7wafbltlvq5moaecvqycclazs5c2erifcrxvzbsh5vmkn6vy",
    "publishedAt": "2026-11-09T14:36:55.386Z",
    "likes": 35,
    "reposts": 4,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzuo44zpyc2h",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Three years of the Zero Debris Charter!\n\nMore than 250 signatories from 36 countries are now working towards a zero debris future by 2030, with confidence growing that the technical targets can be achieved, and new members joining last week in Brasília. \n\nRead more: esa.int/articles/abo...",
    "url": "https://bsky.app/profile/esa.int/post/3mzuo44zpyc2h",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreihktyw6qbtb2f7po64re6swgxe6vnqjnellexwbzeiyczqzqsk6di",
    "publishedAt": "2026-11-09T09:59:26.670Z",
    "likes": 140,
    "reposts": 16,
    "starship": false
  },
  {
    "id": "at://did:plc:cbjn5rfoo4owohtvovqdqoss/app.bsky.feed.post/3mzomy5mwyc2t",
    "platform": "bluesky",
    "author": "Spaceflight Now",
    "handle": "spaceflightnow.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:cbjn5rfoo4owohtvovqdqoss/bafkreib5gq4ycdgpitpk3rlno3j3mnqid6qgubnq7z4ghs4sg3ece5ptxi",
    "text": "SpaceX will deploy another batch of satellites for a clandestine U.S. Space Force program on a Falcon 9 rocket launch from California. Liftoff is scheduled for 4:48 p.m. PST (7:48 p.m. EST / 0048 UTC). Watch live coverage: youtube.com/live/5zPZKJi...",
    "url": "https://bsky.app/profile/spaceflightnow.com/post/3mzomy5mwyc2t",
    "image": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:cbjn5rfoo4owohtvovqdqoss/bafkreifeiwokwichjslt5g4sz7lhxamz4ekdprtjmdowvfc66geqd6wsuu",
    "publishedAt": "2026-11-07T00:23:19.581Z",
    "likes": 5,
    "reposts": 1,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzlbclgvak2w",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Closing in on Didymos. ☄️\n\nOur planetary defence mission Hera has captured its first close-up of the binary asteroid system, 60 km away, as it prepares to investigate the aftermath of DART’s historic impact with Dimorphos.\n\nDetailed images of both asteroids are coming on 25 November.",
    "url": "https://bsky.app/profile/esa.int/post/3mzlbclgvak2w",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreie74pu62mcpdauj6bvjmel2wkiotxw2j7lxwd3iehfc35bgdfou4q",
    "publishedAt": "2026-11-05T16:16:26.882Z",
    "likes": 357,
    "reposts": 69,
    "starship": false
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3mzkig4us3c2i",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibctnba56zdlocnvavlswrjjzk2w5dykxbl5oprinif4dlgdilp3u",
    "text": "Mars may not be geologically dead after all. 🔴 \n\nOur ExoMars Trace Gas Orbiter has detected hydrogen chloride above volcanic fissures in the Alba Mons region, which scientists suggest could be linked to dormant volcanic activity beneath the surface. \n\nRead more: new.esa.int/articles/new...",
    "url": "https://bsky.app/profile/esa.int/post/3mzkig4us3c2i",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreibdzzekyojnq2nnsdacgfv5gup55vrkflhppemytukaxelnn2x3c4",
