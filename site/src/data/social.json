    "starship": true
  },
  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3mzwmett3cc2i",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreic7pwkmzswncacrgd7sp2zpyfdzijbvn5ai4sznhcj6b6wi7vjx54",
    "text": "Can a booster roll to the pad in the rain? Yeah, apparently.\n\nBooster 22 is now at the pad and being lifted onto the OLM. Here's a timelapse of the rainy rollout. Watch the lift live at nsf.live/starbase",
    "url": "https://bsky.app/profile/nasaspaceflight.com/post/3mzwmett3cc2i",
    "image": "https://video.bsky.app/watch/did%3Aplc%3Ayifpqamzwvp3g4szr44mz37r/bafkreift5fwig22m4c7jxq3vjpzb5kxk7saiqofi2bvvym4ljxkdq3qqqy/thumbnail.jpg",
    "publishedAt": "2026-11-10T04:33:50.671Z",
    "likes": 28,
    "reposts": 2,
    "starship": true
  },
  {
