    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:uwe7uhjncj4ducqvn5xmma7b/bafkreifardcewbjvy3wavhw5y3p7cynoofepkue2xpwyeqmqtsklnq3vle",
