  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3n37ap5nbi22f",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreic7pwkmzswncacrgd7sp2zpyfdzijbvn5ai4sznhcj6b6wi7vjx54",
    "text": "The McGregor crew has had an interesting day. After going 5 months exactly without a RUD (Rapid Unscheduled Dissasembly), McGregor has seemingly had two RUDs today at the Raptor Engine test stands. As always, we do not know if this was part of SpaceX's testing to failure or not intentional.",
    "url": "https://bsky.app/profile/nasaspaceflight.com/post/3n37ap5nbi22f",
    "image": "https://video.bsky.app/watch/did%3Aplc%3Ayifpqamzwvp3g4szr44mz37r/bafkreidnd22zhfoqjitulgymgz6n3x7sjca4slrjk5z4lxiloa2dtarg6u/thumbnail.jpg",
