    "likes": 30,
    "reposts": 2,
    "starship": false
  },
  {
    "id": "at://did:plc:yifpqamzwvp3g4szr44mz37r/app.bsky.feed.post/3n36erxjudc2b",
    "platform": "bluesky",
    "author": "NASASpaceflight.com",
    "handle": "nasaspaceflight.com",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yifpqamzwvp3g4szr44mz37r/bafkreic7pwkmzswncacrgd7sp2zpyfdzijbvn5ai4sznhcj6b6wi7vjx54",
    "text": "Starship Update (November 25, 2026) - SpaceX is getting back in the groove as we head towards Starship flights 16 and 17, as we’ve got vehicles testing at Massey’s, and stacking at the production site.\n\nPremiering now at youtu.be/_XSaGohrCR4",
    "url": "https://bsky.app/profile/nasaspaceflight.com/post/3n36erxjudc2b",
    "image": "https://video.bsky.app/watch/did%3Aplc%3Ayifpqamzwvp3g4szr44mz37r/bafkreibdamq4evs7c2b4pscdam4vgof4pqrbvbfyyuelnyu33l2yfezgx4/thumbnail.jpg",
    "publishedAt": "2026-11-26T00:04:28.241Z",
    "likes": 26,
    "reposts": 5,
    "starship": true
  },
  {
    "id": "at://did:plc:yqfmy2p54vqgekrcz5zzykhl/app.bsky.feed.post/3n35ujdcsvk2e",
    "platform": "bluesky",
    "author": "European Space Agency",
    "handle": "esa.int",
    "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreiaj4ng5nwiv6hkptuzo4ijlgifxc7tptrwag6advsmjx2fohkwtfu",
    "text": "Two years of travelling. One pair of asteroids. A lot of very excited scientists.\n\nHera's team are live now, talking through the first images. Don't leave early. There may be a surprise 👀",
    "url": "https://bsky.app/profile/esa.int/post/3n35ujdcsvk2e",
    "image": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:yqfmy2p54vqgekrcz5zzykhl/bafkreidgpr2vt3rlh2ehks76ten5w7g72ge76akah735jonjjaqblnnsai",
